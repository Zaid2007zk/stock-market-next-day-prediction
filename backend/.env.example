# ==============================================================================
# MarketPulse Backend Staging Environment Variables Template
# Target: Free-Tier Staging (Render Free + Supabase Free + Upstash Free)
# ZERO SECRETS COMMITTED. Copy to .env for local testing.
# ==============================================================================

ENVIRONMENT=staging
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (Allowed origins)
CORS_ORIGINS=["https://staging-marketpulse.pages.dev","http://localhost:3000"]

# Supabase Free Tier Configuration (PostgreSQL 15 + Supabase Auth)
# Policy: Database-enforced Row-Level Security (RLS) linked to auth.uid()
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Upstash Serverless Redis Free Tier Configuration
# Official Free Quota: 500,000 commands/month
# Storage Bounds: 250 MB free-plan storage (256 MB max data size limit)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Rate Limiting Parameters (Token-Bucket)
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# AI Provider Configuration (Explicitly unconfigured for Milestones 1 & 2)
AI_PROVIDER=none
AI_MODEL=unresolved
AI_API_KEY=
